struct VS_INPUT
{
    float3 position : POSITION;
    float2 texCoord : TEXCOORD0;
    float3 normal : NORMAL;
    float3 color : COLOR;
};

struct VS_OUTPUT
{
    float4 position : POSITION;
    float3 worldPos : TEXCOORD0;
    float2 texCoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 color : COLOR;
};

void main(
    float3 position : POSITION,
    float2 texCoord : TEXCOORD0,
    float3 normal : NORMAL,
    float4 color : COLOR0,

    out float4 outPosition : POSITION,
    out float3 outWorldPos : TEXCOORD0,
    out float2 outTexCoord : TEXCOORD1,
    out float3 outNormal : TEXCOORD2,
    out float3 outColor : COLOR,

    uniform float4x4 Mvp,
    uniform float4x4 Model)
{
    // World space
    outWorldPos = mul(Model, float4(position, 1.0)).xyz;

    // Transform using inverse transpose
    outNormal = normalize(mul((float3x3)Model, normal));

    outTexCoord = texCoord;
    outColor = color.rgb;
    outPosition = mul(Mvp, float4(position, 1.0));
}