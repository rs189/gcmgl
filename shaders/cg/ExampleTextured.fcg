struct FragmentInput_t
{
    float2 texCoord : TEXCOORD0;
};

struct FragmentOutput_t
{
    float4 color : COLOR;
};

FragmentOutput_t main(FragmentInput_t input, uniform sampler2D tex : TEXUNIT0)
{
    FragmentOutput_t output;
    output.color = tex2D(tex, input.texCoord);

    return output;
}