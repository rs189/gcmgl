struct VertexInput_t
{
    float3 position : POSITION;
    float2 texCoord : TEXCOORD0;
    float3 normal : NORMAL;
    float3 color : COLOR;
};

struct VertexOutput_t
{
    float4 position : POSITION;
    float3 worldPos : TEXCOORD0;
    float2 texCoord : TEXCOORD1;
    float3 normal : TEXCOORD2;
    float3 color : COLOR;
};

VertexOutput_t main(
    float3 position : POSITION,
    float2 texCoord : TEXCOORD0,
    float3 normal : NORMAL,
    float4 color : COLOR0,

    uniform float4x4 Mvp,
    uniform float4x4 Model)
{
    VertexOutput_t output;

    output.worldPos = mul(Model, float4(position, 1.0)).xyz;

    output.normal = normalize(mul((float3x3)Model, normal));

    output.texCoord = texCoord;
    output.color = color.rgb;
    output.position = mul(Mvp, float4(position, 1.0));

    return output;
}