float4 main(
    float2 texCoord : TEXCOORD0,
    uniform sampler2D sceneTex) : COLOR
{
    float3 c = tex2D(sceneTex, texCoord).rgb;
    float luma = dot(c, float3(0.299, 0.587, 0.114));
    return float4(lerp(float3(luma, luma, luma), c, 0.85), 1.0);
}