struct FragmentInput_t
{
    float3 color : COLOR;
};

struct FragmentOutput_t
{
    float4 color : COLOR;
};

FragmentOutput_t main(FragmentInput_t input)
{
    FragmentOutput_t output;
    output.color = float4(input.color, 1.0);

    return output;
}